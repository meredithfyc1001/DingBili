{
  "name": "dingbili",
  "version": "0.1.0-p1.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "DingTalk-style Bilibili userscript derived from Jack-Cherish/BiliShu (0.6.1)",
  "repository": {
    "type": "git",
    "url": "https://github.com/meredithfyc1001/DingBili.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:repro": "node scripts/verify-reproducible-build.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chrome": "playwright test --project=chrome",
    "test:e2e:edge": "playwright test --project=msedge",
    "test": "npm run build && npm run test:unit && npm run verify:repro && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2"
  }
}
